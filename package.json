{
  "name": "banana-nocturne",
  "private": true,
  "version": "0.1.0",
  "description": "Survivor-like browser game MVP: a monkey throws bananas at gothic-horror monsters until dawn.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
